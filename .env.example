COMPOSE_PROJECT_NAME=secondvoice

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://secondvoice:secondvoice@db:5432/secondvoice
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# --- Meta Model API (https://dev.meta.ai → API Keys) ---
# Leave empty to run with the labelled dev fallback (see docs/model-integrations.md).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_ASR_MODEL=muse-voice-transcribe-1.0
META_SPARK_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_RETRIES=1
META_RETRY_BACKOFF_S=1.0
SECOND_ASR_ENABLED=false
SECOND_ASR_PROVIDER=
LOCAL_ASR_MODEL=
LOCAL_ASR_DEVICE=cpu
LOCAL_ASR_COMPUTE=int8

# --- Speech restoration (CLARIS P4; no secrets) ---
# Disabled by default. Needs the inference sidecar + weights in ./models/claris.
RESTORATION_ENABLED=false
RESTORATION_S2U_URL=http://inference:8001
RESTORATION_CHECKPOINT=wtimit_44spkrs_trained.pt
RESTORATION_BEAM=5
RESTORATION_TIMEOUT_S=180.0

# --- Production hardening (Phase 12) ---
# Auth rate limit per IP per minute (single-process scope).
RATE_LIMIT_PER_MINUTE=120

# --- TTS (one of google|azure|elevenlabs|webspeech-fallback) ---
TTS_PROVIDER=webspeech-fallback
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

# --- Storage / app ---
STORAGE_DIR=/data/audio
AUDIO_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
